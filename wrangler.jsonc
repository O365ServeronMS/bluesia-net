{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bluesia",
  "account_id": "e7a1b4f8820d086aec2e68bfee41bd48",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "bluesia.net,www.bluesia.net"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
