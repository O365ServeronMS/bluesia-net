---
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/main.css';
---
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- ── SEO ─────────────────────────────────────────────────── -->
  <title>Bluesia — Nhà đầu tư Năng lượng Tái tạo Việt Nam | Renewable Energy Investment</title>
  <meta name="description" content="Bluesia là nhà đầu tư tiên phong trong lĩnh vực năng lượng tái tạo tại Việt Nam. Chúng tôi phát triển và vận hành các dự án điện mặt trời, điện gió và thủy điện với tổng công suất hơn 500MW." />
  <meta name="keywords" content="năng lượng tái tạo, điện mặt trời, điện gió, thủy điện, đầu tư năng lượng, renewable energy Vietnam, Bluesia" />
  <meta name="author" content="Bluesia Investment Group" />
  <link rel="canonical" href="https://bluesia.net/" />

  <!-- ── Open Graph ──────────────────────────────────────────── -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://bluesia.net/" />
  <meta property="og:title"       content="Bluesia — Nhà đầu tư Năng lượng Tái tạo Việt Nam" />
  <meta property="og:description" content="Tiên phong xây dựng hạ tầng năng lượng xanh tại Việt Nam. 500+ MW công suất. 15+ dự án. 12 tỉnh thành." />
  <meta property="og:image"       content="https://bluesia.net/assets/images/hero-bg-960.webp" />
  <meta property="og:image:width"  content="960" />
  <meta property="og:image:height" content="640" />
  <meta property="og:locale"      content="vi_VN" />
  <meta property="og:site_name"   content="Bluesia" />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:title"      content="Bluesia — Nhà đầu tư Năng lượng Tái tạo Việt Nam" />
  <meta name="twitter:description" content="Tiên phong xây dựng hạ tầng năng lượng xanh tại Việt Nam. 500+ MW công suất." />
  <meta name="twitter:image"      content="https://bluesia.net/assets/images/hero-bg-960.webp" />

  <!-- ── Preload LCP Hero Image (AVIF preferred, 960w mobile-first) ── -->
  <link rel="preload" as="image"
        href="/assets/images/hero-bg-960.avif"
        type="image/avif"
        imagesrcset="/assets/images/hero-bg-640.avif 640w, /assets/images/hero-bg-960.avif 960w"
        imagesizes="100vw"
        fetchpriority="high" />

  <!-- ── DNS Prefetch / Preconnect ──────────────────────────── -->

  <!-- ── Fonts: Non-blocking (font-display:swap via &display=swap) ── -->
  <!-- Only load 3 weights used: 300, 400, 600 (removed 200,500,700) -->

  <!-- ── Critical above-the-fold CSS (inline) ───────────────── -->
  <style>
  /* === RESET & BASE === */
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#f0efe9;color:#0f0e12;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  img,video{max-width:100%;display:block}
  picture{display:block}
  a{text-decoration:none;color:inherit}
  button{cursor:pointer;border:none;background:none;font:inherit}
  /* === FOCUS VISIBLE === */
  :focus-visible{outline:2px solid #c8a84b;outline-offset:3px;border-radius:2px}
  /* === REDUCED MOTION === */
  @media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  /* === UTILITIES === */
  .container{width:100%;max-width:1280px;margin:0 auto;padding:0 24px}
  /* === NAVBAR === */
  .navbar{position:fixed;top:0;left:0;right:0;z-index:1000;height:72px;transition:background .5s ease,backdrop-filter .5s ease,box-shadow .5s ease}
  .navbar.transparent{background:transparent}
  .navbar.scrolled{background:rgba(15,14,18,.88);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);box-shadow:0 1px 0 rgba(255,255,255,.06),0 8px 32px rgba(15,14,18,.10)}
  /* === HERO === */
  .hero{position:relative;width:100%;height:100vh;min-height:680px;display:flex;align-items:flex-end;overflow:hidden}
  .hero-bg{position:absolute;inset:0;z-index:0;background:#0f0e12}
  .hero-bg picture,.hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 60%}
  .hero-bg img{transform:scale(1.04);transition:transform 8s cubic-bezier(.25,.1,.25,1)}
  .hero.loaded .hero-bg img{transform:scale(1)}
  .hero-overlay{position:absolute;inset:0;z-index:1;background:linear-gradient(to bottom,rgba(15,14,18,.30) 0%,rgba(15,14,18,.20) 30%,rgba(15,14,18,.55) 70%,rgba(15,14,18,.92) 100%)}
  .hero-content{position:relative;z-index:2;width:100%;max-width:1280px;margin:0 auto;padding:0 24px 80px}
  .hero-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px 6px 10px;border-radius:100px;border:1px solid rgba(200,168,75,.4);background:rgba(200,168,75,.1);backdrop-filter:blur(8px);margin-bottom:24px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#dbbf68}
  .badge-dot{width:6px;height:6px;border-radius:50%;background:#c8a84b;flex-shrink:0;animation:pulse-dot 2s ease-in-out infinite}
  @keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}
  .hero-title{font-size:clamp(40px,6vw,76px);font-weight:300;line-height:1.08;letter-spacing:-.02em;color:#fff;margin-bottom:24px;max-width:840px}
  .hero-title-accent{background:linear-gradient(135deg,#3d9b66 0%,#dbbf68 60%,#c8a84b 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:inline-block}
  .hero-subtitle{font-size:18px;font-weight:300;line-height:1.7;color:rgba(255,255,255,.65);max-width:560px;margin-bottom:40px;letter-spacing:.01em}
  .hero-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  /* === FADE ANIMATIONS === */
  .fade-in{opacity:0;transform:translateY(24px);transition:opacity .5s cubic-bezier(0,0,.2,1),transform .5s cubic-bezier(0,0,.2,1)}
  .fade-in.visible{opacity:1;transform:translateY(0)}
  /* === STATS BAR === */
  .stats-bar{background:#0f0e12;padding:48px 0;position:relative;z-index:10}
  /* === NAV MOBILE — ẩn ngay từ đầu, tránh flash overlay đen === */
  .nav-mobile{display:none}
  </style>

  <!-- ── Structured Data (JSON-LD) ──────────────────────────── -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Bluesia Investment Group",
    "alternateName": "Bluesia",
    "url": "https://bluesia.net",
    "logo": "https://bluesia.net/assets/images/hero-bg-960.webp",
    "description": "Nhà đầu tư tiên phong trong lĩnh vực năng lượng tái tạo tại Việt Nam. Phát triển và vận hành các dự án điện mặt trời, điện gió và thủy điện.",
    "foundingDate": "2015",
    "areaServed": "VN",
    "knowsAbout": ["Solar Energy", "Wind Energy", "Hydropower", "Energy Storage", "Renewable Energy Investment"],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "invest@bluesia.net",
      "telephone": "+84-28-3822-0000",
      "contactType": "investor relations",
      "availableLanguage": ["Vietnamese", "English"]
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "123 Nguyễn Huệ",
      "addressLocality": "Quận 1",
      "addressRegion": "TP. Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "sameAs": [
      "https://linkedin.com",
      "https://facebook.com"
    ]
  }
  </script>

  <!-- ── Favicon ─────────────────────────────────────────────── -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%230f0e12'/><text x='16' y='22' font-family='Inter,sans-serif' font-size='18' font-weight='700' fill='%23c8a84b' text-anchor='middle'>B</text></svg>" />

  <!-- Cloudflare Turnstile: loaded asynchronously for the contact form. -->
  <script
    is:inline
    id="turnstile-script"
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>
</head>
<body>
  <slot />
  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
