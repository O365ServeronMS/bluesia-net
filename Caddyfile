# ══════════════════════════════════════════════════════════════
# Caddyfile — bluesia.net  (updated for performance)
# Standard Caddy v2, tự động SSL via Let's Encrypt
# ══════════════════════════════════════════════════════════════

{
    email admin@bluesia.net

    servers {
        protocols h1 h2 h3
    }
}

bluesia.net, www.bluesia.net {

    # ── Reverse proxy ──────────────────────────────────────────
    reverse_proxy localhost:8080 {
        health_uri      /
        health_interval 30s
        health_timeout  10s
        flush_interval  -1
    }

    # ── Compression ────────────────────────────────────────────
    encode {
        zstd best
        gzip 6
        minimum_length 512
    }

    # ── Cache headers ──────────────────────────────────────────

    # HTML: no cache — always get fresh index.html on deploy
    @html {
        path /
        path /index.html
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Static assets: 1 year immutable
    @assets {
        path /assets/*
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header @assets Vary          "Accept-Encoding, Accept"

    # CSS/JS: 7 days
    @csjs {
        path *.css *.js
    }
    header @csjs Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

    # robots.txt, sitemap.xml
    @seo {
        path /robots.txt /sitemap.xml
    }
    header @seo Cache-Control "public, max-age=86400"

    # ── Security & Performance Headers ─────────────────────────
    header {
        # Preload hint for LCP image (AVIF)
        Link                      "</assets/images/hero-bg-960.avif>; rel=preload; as=image; type=image/avif; imagesrcset=/assets/images/hero-bg-640.avif 640w\\,/assets/images/hero-bg-960.avif 960w; imagesizes=100vw"
        X-Frame-Options           "SAMEORIGIN"
        X-Content-Type-Options    "nosniff"
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # ── Logging ────────────────────────────────────────────────
    log {
        output file /var/log/caddy/bluesia.net.log {
            roll_size    10mb
            roll_keep    5
            roll_keep_for 720h
        }
        format json
        level  INFO
    }
}

# ══════════════════════════════════════════════════════════════
# 100MB Server-side cache (cần xcaddy + cache plugin)
# ── Hướng dẫn:
#
#   xcaddy build --with github.com/caddyserver/cache-handler
#   mkdir -p /var/cache/caddy && chown caddy:caddy /var/cache/caddy
#
# Thêm vào global block:
#   order cache before rewrite
#   cache {
#       ttl 1h
#       max_cachable_response_body_bytes 5242880
#       nuts {
#           path /var/cache/caddy
#           configuration { MaxSize 104857600 }
#       }
#   }
#
# Thêm vào virtual host:
#   cache
# ══════════════════════════════════════════════════════════════
