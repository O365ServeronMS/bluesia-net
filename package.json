{
  "name": "bluesia-net",
  "version": "2.0.0",
  "description": "Bluesia.net landing page - Astro static site",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.136.1"
  },
  "allowScripts": {
    "esbuild@0.28.1 || 0.28.2": true,
    "workerd@1.20260921.1": true
  }
}
