{
  "name": "bluesia-net",
  "version": "2.0.0",
  "description": "Bluesia.net landing page - Astro static site",
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.1 || 0.28.2": true,
    "workerd@1.20261103.1": true
  }
}
